# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# postgres db variables
POSTGRES_USER=app
POSTGRES_DB=homekeeper
POSTGRES_PASSWORD=[INPUT-PASSWORD]
DATABASE_URL=postgresql://app:[INPUT-PASSWORD]@localhost:5432/homekeeper

# better auth variables
BETTER_AUTH_SECRET=[https://better-auth.com/docs/installation#set-environment-variables]
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app
